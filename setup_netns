#!/bin/sh

sudo ip netns del ns_src
sudo ip netns del ns_dst0
sudo ip netns del ns_dst1
sudo ip netns del ns_mid

ip link del ns_veth_s &> /dev/null

ip link del ns_veth_d0 &> /dev/null
ip link del ns_veth_d1 &> /dev/null

sleep 0.1

sudo ip netns add ns_src
sudo ip netns add ns_dst0
sudo ip netns add ns_dst1
sudo ip netns add ns_mid

sudo ip link add ns_veth_s type veth peer name ns_veth_mids

sudo ip link add ns_veth_d0 type veth peer name ns_veth_midd0
sudo ip link add ns_veth_d1 type veth peer name ns_veth_midd1

sleep 0.1

sudo ip link set ns_veth_s netns ns_src

sudo ip link set ns_veth_d0 netns ns_dst0

sudo ip link set ns_veth_d1 netns ns_dst1

sudo ip link set ns_veth_mids netns ns_mid
sudo ip link set ns_veth_midd0 netns ns_mid
sudo ip link set ns_veth_midd1 netns ns_mid

sudo ip netns exec ns_src ip link set ns_veth_s up

sudo ip netns exec ns_dst0 ip link set ns_veth_d0 up

sudo ip netns exec ns_dst1 ip link set ns_veth_d1 up

sudo ip netns exec ns_mid ip link set ns_veth_mids up
sudo ip netns exec ns_mid ip link set ns_veth_midd0 up
sudo ip netns exec ns_mid ip link set ns_veth_midd1 up

sleep 0.1

sudo ip netns exec ns_src ip addr add 10.0.0.1/24 dev ns_veth_s
sudo ip netns exec ns_src ip addr add 2001:db0::1/64 dev ns_veth_s

sudo ip netns exec ns_dst0 ip addr add 10.0.2.1/24 dev ns_veth_d0
sudo ip netns exec ns_dst0 ip addr add 2001:db2::1/64 dev ns_veth_d0

sudo ip netns exec ns_dst1 ip addr add 10.0.3.1/24 dev ns_veth_d1
sudo ip netns exec ns_dst1 ip addr add 2001:db3::1/64 dev ns_veth_d1

sudo ip netns exec ns_mid ip addr add 10.0.0.2/24 dev ns_veth_mids
sudo ip netns exec ns_mid ip addr add 2001:db0::2/64 dev ns_veth_mids
sudo ip netns exec ns_mid ip addr add 10.0.2.2/24 dev ns_veth_midd0
sudo ip netns exec ns_mid ip addr add 2001:db2::2/64 dev ns_veth_midd0
sudo ip netns exec ns_mid ip addr add 10.0.3.2/24 dev ns_veth_midd1
sudo ip netns exec ns_mid ip addr add 2001:db3::2/64 dev ns_veth_midd1

sudo ip netns exec ns_mid sysctl net.ipv4.ip_forward=1
sudo ip netns exec ns_mid sysctl net.ipv6.conf.all.forwarding=1

sudo ip netns exec ns_src ip route add default nexthop via 10.0.0.2 dev ns_veth_s weight 1
sudo ip netns exec ns_src ip -6 route add default nexthop via 2001:db0::2 dev ns_veth_s weight 1
sudo ip netns exec ns_dst0 ip route add default nexthop via 10.0.2.2 dev ns_veth_d0 weight 1
sudo ip netns exec ns_dst0 ip -6 route add default nexthop via 2001:db2::2 dev ns_veth_d0 weight 1
sudo ip netns exec ns_dst1 ip route add default nexthop via 10.0.3.2 dev ns_veth_d1 weight 1
sudo ip netns exec ns_dst1 ip -6 route add default nexthop via 2001:db3::2 dev ns_veth_d1 weight 1

sudo ip netns exec ns_mid smcrouted -l debug -I smctable
sudo ip netns exec ns_mid smcroutectl -I smctable add ns_veth_mids 239.239.239.35 ns_veth_midd0 ns_veth_midd1
